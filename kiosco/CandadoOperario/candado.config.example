# Candado de operario - configuracion de ESTA PC (plantilla)
# Copiar como candado.config y completar. El instalador lo genera solo.
#
# Servidor: dominio o IP del servidor. Si no lleva esquema se asume http://
# (uso en LAN); para producir por internet escribe el dominio o https://dominio.
# Si el sitio no esta en la raiz del servidor, agrega la carpeta (ej. localhost/electronicasINV).
Servidor=192.168.1.10
Estacion=Evolution-Linea1
Token=
AutoBloqueoMinutos=15
PermitirSalir=false
# Carpeta donde Delvis guarda sus bitacoras y configuracion
DelvisDir=C:\Satake\Delvis\Gui
# Con una falla activa de Delvis (FaultSet sin FaultClear desde que abrio Delvis) la pantalla
# parpadea en rojo. false = desactivado. FallasIgnorar: grupos o codigos separados por coma
# (ej. 13 o 19:35) que no deben avisar. Ademas calla los grupos marcados en «Ignorar Fallas» de Delvis
# (IgnorarComoDelvis=false para no tomarlos en cuenta).
AvisoFallas=true
FallasIgnorar=
IgnorarComoDelvis=true
# Con un operario con nivel de Delvis (se asigna en el sistema, junto a su codigo), cuando Delvis pide la
# contrasena de ese nivel o uno menor, el candado la escribe. Las contrasenas se ponen en el sistema
# (Usuarios > Contrasenas de Delvis) y llegan al sincronizar. false = desactivado.
NivelDelvis=true
# Estado del candado por la red (para la tablet): puerto y las unicas IPs a las que contesta. 0 = apagado.
EstadoPuerto=8765
EstadoDesde=192.168.11.141,192.168.11.142
