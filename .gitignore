.claude/
.codex_spreadsheet_work/
.env
logs/
outputs/
node_modules/

# Candado de operario: config con token y binarios generados
kiosco/CandadoOperario/candado.config
kiosco/CandadoOperario/*.exe
kiosco/CandadoOperario/Output/

# Llave PRIVADA con la que se firman las actualizaciones: vive fuera del repo (%USERPROFILE%\.honducafe);
# estas reglas son por si alguna vez se copia dentro. Quien la tenga puede instalar programas en las PCs de planta.
.honducafe/
*firma-privada*

# Cuarto de control: binario generado y config local
kiosco/CuartoControl/*.exe
kiosco/CuartoControl/*.dll
kiosco/CuartoControl/CuartoControl.config
