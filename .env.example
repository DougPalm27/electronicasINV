# Copia este archivo a .env y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# ── Base de datos (SQL Server) ──────────────────────────────
DB_HOST=localhost\SQLEXPRESS
DB_NAME=ElectronicasDB
DB_USER=
DB_PASSWORD=

# ── Correo (SMTP) ────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Sistema Electronicas
