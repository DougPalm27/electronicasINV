# Copia este archivo a .env y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# ── Base de datos (SQL Server) ──────────────────────────────
DB_HOST=localhost\SQLEXPRESS
DB_NAME=ElectronicasDB
DB_USER=
DB_PASSWORD=

# ── Correo ───────────────────────────────────────────────────
# Usa smtp en local y sendgrid en producción.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Sistema Electronicas
MAIL_TIMEOUT=20

# SendGrid (cuando MAIL_DRIVER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Sistema Electronicas
